# ── Clerk Auth ───────────────────────────────────────────────────────────────
# Get from https://clerk.com → Your project → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from https://supabase.com → Your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Encryption ────────────────────────────────────────────────────────────────
# 32-char random string for AES-256 encryption of Fyers credentials at rest
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=your_32_char_secret_key_here_1234

# ── Clerk Webhook ─────────────────────────────────────────────────────────────
# Get from Clerk dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# (set http://localhost:3000 for local dev)
