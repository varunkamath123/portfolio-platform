# ── Clerk Auth ───────────────────────────────────────────────────────────────
# Get from https://clerk.com → Your project → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Clerk route config
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from https://supabase.com → Your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Kite Connect (platform-level — all users share this app) ──────────────────
# Copy from C:\quant_trading\.env — same app you already use for FnO bot
# Add https://your-app.vercel.app/api/kite/auth/callback as a redirect URL
# in your Kite Connect app at developers.kite.trade
KITE_API_KEY=fzb6b02xctsp0z24
KITE_API_SECRET=your_kite_api_secret_here

# ── Anthropic (Claude API — MiroFish Q&A) ─────────────────────────────────────
# Reuse the same key already in use by the FnO bot / Claude Code
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Encryption ────────────────────────────────────────────────────────────────
# AES-256 key for encrypting Kite access tokens at rest in Supabase
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_char_secret_key_here_1234

# ── Clerk Webhook ─────────────────────────────────────────────────────────────
# Get from Clerk dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
# Local dev: set to http://localhost:3000
